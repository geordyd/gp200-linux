#!/usr/bin/env python3
"""Require a Conventional Commit subject for local project commits."""
import re
import sys
from pathlib import Path

lines = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
subject = lines[0] if lines else ""
pattern = r"(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9][A-Za-z0-9._/-]*\))?!?: \S.*"
if re.fullmatch(pattern, subject) is None:
    print("Use a Conventional Commit subject: type(scope): summary", file=sys.stderr)
    print("Example: feat(firmware): add full-image recovery", file=sys.stderr)
    sys.exit(1)
